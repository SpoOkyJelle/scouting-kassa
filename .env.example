# Copy this file to .env and set your own values

# ── POS logins ────────────────────────────────────────────────────────────────
PIN=your_admin_pin_here
# CASHIER_PIN=your_cashier_pin_here

# ── Stripe (abonnementen) ─────────────────────────────────────────────────────
# Vind deze keys op https://dashboard.stripe.com/apikeys
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...   (stripe listen --forward-to localhost:3001/api/stripe/webhook)

# Price IDs van je Stripe producten (maak aan in Stripe Dashboard > Products)
# STRIPE_PRICE_ID=price_...          (default / pro plan)
# STRIPE_PRICE_ID_PRO=price_...      (pro plan)
# STRIPE_PRICE_ID_STARTER=price_...  (starter plan)

# ── E-mail (Nodemailer SMTP) ──────────────────────────────────────────────────
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=jouw@gmail.com
# SMTP_PASS=app-wachtwoord
# MAIL_FROM=Tickd <noreply@tickd.nl>
# APP_URL=https://app.tickd.nl

# ── Intern admin panel ────────────────────────────────────────────────────────
# TICKD_ADMIN_KEY=kies-een-lang-willekeurig-wachtwoord
