# Copy this file to .env and fill in your own values.

# ─── Single-tenant SQLite app (current server.js) ────────────────────────────
PIN=your_admin_pin_here
# Optional: set a cashier PIN for limited access (no products/settings)
# CASHIER_PIN=your_cashier_pin_here

# ─── Multi-tenant SaaS (Postgres, see docs/MULTI_TENANT_DESIGN.md) ────────────
# PostgreSQL connection string used by Knex (db/index.js, migrations).
DATABASE_URL=postgres://kassa:kassa@localhost:5432/kassa

# Password for the Postgres container in docker-compose.yml.
POSTGRES_PASSWORD=change_me

# Secret used to sign/validate sessions. Generate a long random value.
SESSION_SECRET=change_me_to_a_long_random_string

# Domain Caddy serves (and gets a TLS cert for). Use "localhost" for local runs.
DOMAIN=localhost

# Optional: used by scripts/import-sqlite.js to create the owner of account 1.
# OWNER_ORG=Scouting Sint Martinus
# OWNER_EMAIL=you@example.com
# OWNER_PASSWORD=choose_a_password
