# Copy this file to .env and fill in your own values.

# PostgreSQL connection string used by the app and Knex (db/index.js, migrations).
# For the docker-compose stack the app uses the internal "db" host instead; this
# value is for host-side use (npm run dev / migrate).
DATABASE_URL=postgres://kassa:kassa@localhost:5432/kassa

# Password for the Postgres container in docker-compose.yml.
POSTGRES_PASSWORD=change_me

# Admin PIN for the quick till login (first account).
PIN=your_admin_pin_here
# Optional: a cashier PIN for limited access (no products/settings).
# CASHIER_PIN=your_cashier_pin_here

# Domain Caddy serves (and gets a TLS cert for). Use "localhost" for local runs.
DOMAIN=localhost
